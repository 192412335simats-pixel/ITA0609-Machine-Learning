from sklearn.linear_model import LinearRegression

# Dataset: Age of car, Kilometers driven
X = [[1,10000],[2,20000],[3,30000],[4,40000],[5,50000]]
y = [900000,750000,600000,450000,300000]

# Train model
model = LinearRegression()
model.fit(X, y)

# Predict price
car = [[3,25000]]
price = model.predict(car)

print("Predicted Car Price:", round(price[0]))
